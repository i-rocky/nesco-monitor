# NESCO account number to monitor (numeric, e.g. 12345678)
NESCO_ACCOUNT_NO=

# Discord channel webhook URL — Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# Optional: balance threshold (taka) for warning post. Default: 500
LOW_BALANCE_THRESHOLD=500

# Optional: SQLite file path. Default: ./nesco.db
DB_PATH=./nesco.db

# Optional: NESCO base URL. Default: https://customer.nesco.gov.bd
NESCO_BASE_URL=https://customer.nesco.gov.bd

# Optional: HTTP timeout for upstream calls. Default: 15s
HTTP_TIMEOUT=15s
